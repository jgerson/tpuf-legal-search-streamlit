# Template for .env, which scripts/setup.sh and teardown.sh read. Copy it:
#   cp env.template .env
# then fill in the values (no quotes or spaces) and load it before running a script:
#   set -a; source .env; set +a
# .env is gitignored.

# HCP service principal with the Contributor role on ONE project.
# HCP portal -> your project -> Access control (IAM) -> Service principals -> Generate key
HCP_CLIENT_ID=
HCP_CLIENT_SECRET=
# Just the project's ID (a UUID), from the project's settings page
HCP_PROJECT_ID=

# HCP Terraform: a USER token (avatar -> Account settings -> Tokens), not an
# organization token, and the organization's name as it appears in the URL
TFE_TOKEN=
TF_CLOUD_ORGANIZATION=
# Optional: the HCP Terraform project to put the workspace in (default: the org's only project)
# TFC_PROJECT=

# turbopuffer key and the shared password for the demo app
TURBOPUFFER_API_KEY=
DEMO_PASSWORD=

# Optional: connect the workspace to GitHub so a commit that adds a firm starts a run.
# First connect HCP Terraform to GitHub: its GitHub App (any workspace -> Settings -> Version Control),
# or an OAuth provider (Organization settings -> Version Control -> Providers).
VCS_REPO=jgerson/tpuf-legal-search-streamlit
