# Streamlit Community Cloud: App settings -> Secrets. Locally: copy to .streamlit/secrets.toml.
# These are the ONLY credentials the app holds. The turbopuffer key, the demo
# password and the tenant list all come from Vault at runtime.

VAULT_ADDR = "https://your-cluster.vault.xxxxxxxx.aws.hashicorp.cloud:8200"
VAULT_NAMESPACE = "admin"
VAULT_ROLE_ID = "from: terraform output role_id"
VAULT_SECRET_ID = "from: vault write -f -field=secret_id auth/approle-legal-search/role/legal-search-st/secret-id"

# Optional
# TURBOPUFFER_REGION = "aws-us-east-1"
# SECRET_REFRESH_SECONDS = "120"
